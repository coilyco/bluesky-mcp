{
  "name": "bluesky-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Authenticated, strictly read-only Bluesky MCP",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "eslint src test",
    "typecheck": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@atproto/api": "0.16.7",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sentry/node": "10.75.3",
    "express": "5.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/node": "22.15.3",
    "eslint": "9.25.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
